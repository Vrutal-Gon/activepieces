# ─────────────────────────────────────────────────────────────
# Instancia de cliente. Copia a clients/<slug>.env (clients/ nunca se sube a git).
# Estos son los secretos DE LA INSTANCIA (paso 3 del alta). No son las claves del cliente:
# esas las mete el propio cliente en Integraciones de su VrutalOS y nunca pasan por aquí.
# ─────────────────────────────────────────────────────────────

# Identidad y URL: https://<slug>.vrutal-labs.com
CLIENT_SLUG=lab
BASE_DOMAIN=vrutal-labs.com

# En VPS se dejan así. En local: BASE_DOMAIN=localhost, EDGE_ENTRYPOINT=web,
# PUBLIC_SCHEME=http, PUBLIC_PORT_SUFFIX=:8088  → http://lab.localhost:8088
EDGE_ENTRYPOINT=websecure
PUBLIC_SCHEME=https
PUBLIC_PORT_SUFFIX=

# Puerto local del VPS para la interfaz de Activepieces (túnel SSH del staff). Único por cliente.
AP_ADMIN_PORT=18001

# Generar cada uno con:  openssl rand -hex 32
AP_ENCRYPTION_KEY=
AP_JWT_SECRET=
AP_POSTGRES_PASSWORD=
MEMORY_POSTGRES_PASSWORD=
QDRANT_API_KEY=

# Redes sociales (Postiz, perfil "social" — opcional, solo si el cliente usa este especialista).
# Puertos locales del VPS, túnel SSH del staff. Únicos por cliente.
POSTIZ_ADMIN_PORT=18002
TEMPORAL_UI_ADMIN_PORT=18003

# Generar cada uno con:  openssl rand -hex 32
POSTIZ_JWT_SECRET=
POSTIZ_POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_PASSWORD=

# Las credenciales de las apps de redes sociales (Client ID/Secret de LinkedIn y compañía)
# NO van aquí: son de la app que crea el propio CLIENTE en LinkedIn Developers, y las pega él
# en VrutalOS → Integraciones. Postiz se las pide a su VrutalOS al arrancar (postiz/boot.sh) y
# postiz_agent lo reinicia cuando cambian. Nunca nos las manda ni las escribimos en este
# fichero: la pantalla del cliente le da las URLs de redirección que tiene que copiar.

# Base de las Edge Functions del Supabase de ESTE cliente, sin barra final.
# Formato: https://<ref>.supabase.co/functions/v1
VRUTALOS_FUNCTIONS_BASE_URL=
# Token de servidor a servidor de esta instancia (cabecera X-AP-Token). Debe ser EL MISMO
# valor que el secret SOCIAL_APP_TOKEN de las Edge Functions de este cliente.
# Generar con:  openssl rand -hex 32
SOCIAL_APP_TOKEN=
# Cada cuántos segundos mira el agente si hay credenciales nuevas (30 por defecto).
POSTIZ_AGENT_INTERVAL=30

# Supabase del cliente (datos de la app). Solo URL y anon key: son públicas por diseño, protegidas por RLS.
VRUTALOS_SUPABASE_URL=https://<ref>.supabase.co
VRUTALOS_SUPABASE_ANON_KEY=

# Imagen de la app VrutalOS (perfil "app"), con versión fija.
VRUTALOS_WEB_IMAGE=vrutalos-web:dev
