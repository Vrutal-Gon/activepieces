# Proyecto Supabase del cliente (uno por instancia). Solo claves públicas: nunca la service_role.
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable o anon key>
# Nombre de la empresa que se muestra en la barra lateral
VITE_TENANT_NAME=<nombre de la empresa>
# URL publica de Postiz de esta instancia (para las URLs de redireccion que el cliente
# copia en el portal del proveedor). En produccion se deduce del host, aqui no: la app de
# desarrollo corre en localhost:5173, sin el slug del cliente del que deducirla.
VITE_SOCIAL_PUBLIC_URL=
