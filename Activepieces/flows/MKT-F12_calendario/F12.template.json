                      "value": false
                    }
                  }
                },
                "nextAction": {
                  "name": "step_5",
                  "valid": true,
                  "skip": false,
                  "displayName": "Ordena · EditorialPlan",
                  "type": "CODE",
                  "settings": {
                    "input": {
                      "sources": [
                        "{{step_4}}"
                      ]
                    },
                    "sourceCode": {
                      "code": "/* vrutal-block {\n  \"block\": \"Ordena · a EditorialPlan\",\n  \"kind\": \"normalize\",\n  \"variant\": {},\n  \"consumes\": [\"salida del paso anterior\"],\n  \"produces\": \"EditorialPlan\",\n  \"inputs\": {\"sources\": [\"{{step_4}}\"]}\n} */\n// Paso Code de Activepieces. Convierte la salida anterior en filas EditorialPlan validadas.\n// Fail-closed: si no queda ninguna fila valida, el paso falla y nada se escribe.\n// Contrato: nuevo, propuesto. Los campos son una PROPUESTA hasta que el founder los apruebe.\n\nconst FIELDS: { name: string; req: boolean; enum: string[] | null; default: string | null; sourced: boolean }[] = [{\"name\": \"week\", \"req\": true, \"enum\": null, \"default\": null, \"sourced\": false}, {\"name\": \"publish_at\", \"req\": true, \"enum\": null, \"default\": null, \"sourced\": false}, {\"name\": \"piece_title\", \"req\": true, \"enum\": null, \"default\": null, \"sourced\": false}, {\"name\": \"channel\", \"req\": true, \"enum\": null, \"default\": null, \"sourced\": false}, {\"name\": \"target_keyword\", \"req\": true, \"enum\": null, \"default\": null, \"sourced\": false}, {\"name\": \"brief_id\", \"req\": false, \"enum\": null, \"default\": null, \"sourced\": false}];\nconst LOOKUP_KEY = null;\nconst MAX_ROWS = 200; // techo por ejecucion\n\nconst clean = (v: unknown, max = 2000) =>\n  (Array.isArray(v) ? v.join(' | ') : String(v ?? ''))\n    .replace(/[\\u0000-\\u001f]/g, ' ')\n    .replace(/^[=+\\-@]/, \"'$&\") // anti formula: una celda nunca empieza por = + - @\n    .trim()\n    .slice(0, max);\n\nconst toList = (src: unknown): Record<string, unknown>[] => {\n  let data: unknown = src;\n  if (typeof data === 'string') {\n    const a = data.search(/[\\[{]/);\n    const last = Math.max(data.lastIndexOf('}'), data.lastIndexOf(']'));\n    if (a < 0 || last <= a) return [];\n    try { data = JSON.parse(data.slice(a, last + 1)); } catch { throw new Error('El JSON recibido no es valido'); }\n  }\n  const arr = Array.isArray(data)\n    ? data\n    : data && typeof data === 'object' && Array.isArray((data as { items?: unknown }).items)\n      ? (data as { items: unknown[] }).items\n      : data && typeof data === 'object' ? [data] : [];\n  return arr\n    .map((x) => (x && typeof x === 'object' && 'values' in x ? (x as { values: unknown }).values : x))\n    .filter((x): x is Record<string, unknown> => !!x && typeof x === 'object' && !Array.isArray(x));\n};\n\nexport const code = async (inputs: { sources: unknown[]; lookup?: unknown }) => {\n  const ranAt = new Date().toISOString();\n  const day = ranAt.slice(0, 10);\n  const records = (inputs.sources ?? []).flatMap((s) => toList(s));\n  const lookupRows = LOOKUP_KEY ? toList(inputs.lookup) : [];\n  const byKey = new Map(lookupRows.map((r) => [String(r[LOOKUP_KEY as string] ?? ''), r]));\n\n  const rows: Record<string, string>[] = [];\n  let discarded = 0;\n  for (const rec of records) {\n    const extra = LOOKUP_KEY ? byKey.get(String(rec[LOOKUP_KEY] ?? '')) ?? {} : {};\n    const row: Record<string, string> = { fecha: day };\n    let ok = true;\n    for (const fd of FIELDS) {\n      let v = clean(rec[fd.name] ?? extra[fd.name] ?? fd.default ?? '');\n      if (fd.sourced && v && !/https?:\\/\\/|fuente:/i.test(v)) v = ''; // la prueba cita fuente o queda vacia\n      if (v && fd.enum && !fd.enum.includes(v.toLowerCase())) { ok = false; break; }\n      if (fd.enum && v) v = v.toLowerCase();\n      if (fd.req && !v) { ok = false; break; }\n      row[fd.name] = v;\n    }\n    if (!ok) { discarded++; continue; }\n    rows.push(row);\n    if (rows.length >= MAX_ROWS) break;\n  }\n  if (rows.length === 0) throw new Error('Ninguna fila valida para EditorialPlan (' + discarded + ' descartadas)');\n  return { rows, count: rows.length, discarded, ran_at: ranAt, rows_json: JSON.stringify(rows) };\n};\n",
                      "packageJson": "{}"
                    },
