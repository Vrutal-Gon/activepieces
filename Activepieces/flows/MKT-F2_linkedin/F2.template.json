                          "sourceCode": {
                            "code": "/* vrutal-block { \"block\": \"Pide permiso · founder: texto + fecha\", \"kind\": \"approve\", \"part\": \"6/6\" } */\n// El enlace de reanudacion es un GET sin cuerpo, asi que al despertar el flujo no sabe que se\n// decidio: se lo pregunta a approval-result (paso 5/6). NO se lee `approved` de la pieza\n// legacy: approval-decide llama al enlace tal cual, sin ?action=, y la pieza daria false\n// siempre. Fail-closed: cualquier cosa que no sea una aprobacion explicita para el flujo.\nexport const code = async (inputs: { approved: string }) => {\n  if (String(inputs.approved) !== 'true') {\n    throw new Error('Sin aprobacion del founder: el flujo termina aqui (fail-closed).');\n  }\n  return { approved: true };\n};\n",
