<mxCell id="e7" value="5 · POST a Kaneo (la fuente)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B98A12;fontSize=10;exitX=0;exitY=0.5;" edge="1" parent="1" source="write" target="traefik"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="6 · refleja esa fila al momento&lt;br&gt;(no se espera al cron)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E7D32;fontSize=10;" edge="1" parent="1" source="write" target="espejo"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="nota" value="Orden deliberado en la escritura: primero Kaneo (la fuente) y después el espejo. Al revés, un fallo de Kaneo dejaría al cliente viendo una tarjeta que el equipo no tiene.&#10;Mover una tarjeta de columna NO es del cliente: el estado del trabajo lo fija Vrutal." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1020" height="50" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
